# ==============================================================================
# LUAPROT PRODUCTION BACKEND ENVIRONMENT VARIABLES (RAILWAY / VERCEL)
#
# If deploying on Railway:
#   Go to your Railway Service -> "Variables" tab -> Add these variables.
#   (Railway automatically assigns and manages the PORT for you).
#
# If deploying on Vercel:
#   Go to your Vercel Project -> Settings -> "Environment Variables" -> Add these.
# ==============================================================================

# 1. Master LuaProt API Key (REQUIRED for live validation)
# Obtain this from your account dashboard at https://luaprot.com/
# NOTE: Ensure your Railway outbound IP / server IP is whitelisted on luaprot.com
LUAPROT_API_KEY=your_luaprot_api_key_here

# 2. LuaProt Hub ID (REQUIRED for Hub scripts & HWID resets)
# You can find your Hub ID under the "Hubs" section on https://luaprot.com/
LUAPROT_HUB_ID=40511091490620200512

# 3. Allowed Frontend Origin for CORS (Optional)
# Set this to your frontend URL if hosting frontend on Vercel and backend on Railway:
# e.g.: CORS_ORIGIN=https://your-frontend.vercel.app
# Leave empty or set to * to allow all origins.
CORS_ORIGIN=*
